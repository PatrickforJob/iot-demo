extends _layout

block title
  title IoT 陀螺儀監控台

block styles
  link(rel="stylesheet" href="css/dashboard.css")

block content
  header
    div
      h1 🌀 IoT 陀螺儀監控台
      .pipeline #[b 手機陀螺儀] → 網路（MQTT）→ #[b 雲端 Broker] → #[b 這個監控台]
    .tools
      .status
        span.dot#netDot
        span#netText 連線中…
      span.status#count 0 台裝置
      button.primary#qrBtn 顯示 QR code
      button#demoBtn ＋10 個 demo user
      button#resetBtn(disabled) 重置 demo

  .layout
    div
      .panel#detail
        .panel-head
          h2#detailTitle 點選下方裝置查看詳細波形
          button#chartToggle 收合圖表
        canvas#bigChart
        .legend
          span #[i.x]X 軸・前後翻
          span #[i.y]Y 軸・左右翻
          span #[i.z]Z 軸・平面轉
          span #[i.m]總旋轉速度
          span 單位：°/s（每秒轉幾度）
      .pager#gpager
      .grid#grid
        .empty 等待手機連線…#[br]請學生掃描 QR code 開啟網頁

    .sidecol
      .panel
        h2 陀螺儀是什麼？
        .rule
          | #[b 加速度計]量的是「移動」：往哪個方向加速、有多用力。
          br
          | #[b 陀螺儀]量的是「旋轉」：繞著哪個軸轉、每秒轉幾度。
          br
          br
          | 試試看：把手機平放在桌上慢慢轉一圈，手機沒有移動位置，但陀螺儀的「平面轉」會有明顯變化。
        .gyro-axes
          div #[b X 軸・前後翻] 像點頭，手機上緣往前或往後倒
          div #[b Y 軸・左右翻] 像翻書，手機往左或往右倒
          div #[b Z 軸・平面轉] 像方向盤，手機平放原地旋轉
        .hint 卡片上的手機圖示跟著學生手機的傾斜角度轉動（只顯示前後和左右傾斜）。

  #qrOverlay
    #qrBox
      .qr-title 用手機相機掃描
      img#qrImg(alt="QR code")
      .url#qrUrl
      .qr-hint （點任意處關閉）

block scripts
  script(src="lib/qrcode.js")
  script(src="js/dashboard.js")
